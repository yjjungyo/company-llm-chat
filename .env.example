# 회사에서 제공받은 Azure OpenAI 호환 접속 정보
AZURE_OPENAI_ENDPOINT=https://myoffice.com
AZURE_OPENAI_API_KEY=YOUR_COMPANY_API_KEY
AZURE_OPENAI_API_VERSION=2024-12-01
# Azure 환경에 따라 모델명 대신 배포명(deployment name)을 사용해야 할 수 있습니다.
AZURE_OPENAI_MODEL=gpt-5.4
# true: 글자가 생성되는 대로 출력 / false: 응답 완료 후 출력
LLM_STREAM=true
# 선택사항: 사내 서버 타임아웃(초)
LLM_TIMEOUT=120

# Langfuse 추적 (Trace) 설정
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SYSTEM_NAME=LegalChat
